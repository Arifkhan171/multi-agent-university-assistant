# ─────────────────────────────────────────────────────────────
#  .env.example  —  Copy this file → rename to .env
#  Fill in your real values. NEVER commit .env to git!
# ─────────────────────────────────────────────────────────────

# ── OpenAI API Key (required) ─────────────────────────────────
OPENAI_API_KEY=sk-proj-your-openai-key-here

# ── Optional: Groq API Key (alternative LLM) ─────────────────
# GROQ_API_KEY=gsk_your-groq-key-here

# ── University Identity ───────────────────────────────────────
UNIVERSITY_NAME=University of Loralai (UOLI)
BOT_NAME=UOLI Assistant Bot

# ── Optional: LangSmith Tracing ──────────────────────────────
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your-langsmith-key-here
# LANGCHAIN_PROJECT=uoli-chatbot
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
